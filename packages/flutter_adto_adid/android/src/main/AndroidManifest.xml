<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reading the GAID needs AD_ID on Android 13+ (Play services
         ads-identifier merges it too; declared here so it is explicit).
         Declare "Advertising ID" in the Play Console when you ship this. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
