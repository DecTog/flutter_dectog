{
  "$comment": "Golden link-URL parsing cases. Every SDK must turn 'url' into {username, slug}, or reject it (null), given the API 'baseUrl', the optional 'linkRootDomain', and the account's custom 'linkDomains' with its 'username' ('' when not known yet). Shared by every port; flutter_adto runs them in test/url_parser_test.dart.",
  "cases": [
    { "name": "hosted subdomain link", "url": "https://demo.adto.app/welcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "subdomain link on a custom API host", "url": "https://acme.links.example.com/launch", "baseUrl": "https://links.example.com", "expect": { "username": "acme", "slug": "launch" } },
    { "name": "subdomain without a slug", "url": "https://demo.adto.app", "baseUrl": "https://adto.app", "expect": null },
    { "name": "an unrelated domain", "url": "https://example.com/demo/welcome", "baseUrl": "https://adto.app", "expect": null },
    { "name": "path form on the backend host", "url": "http://localhost:8787/r/demo/e2e", "baseUrl": "http://localhost:8787", "expect": { "username": "demo", "slug": "e2e" } },
    { "name": "path form on a production host", "url": "https://links.example.com/r/acme/x", "baseUrl": "https://links.example.com", "expect": { "username": "acme", "slug": "x" } },
    { "name": "a two-segment API path is not a link", "url": "https://links.example.com/api/v1", "baseUrl": "https://links.example.com", "expect": null },
    { "name": "a two-segment API path on localhost is not a link", "url": "http://localhost:8787/api/v1", "baseUrl": "http://localhost:8787", "expect": null },
    { "name": "split deployment: tenant link on the link root", "url": "https://demo.adto.app/welcome", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "split deployment: path form on the API host", "url": "https://app.adto.app/r/demo/welcome", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "split deployment: the API host itself is not a tenant", "url": "https://app.adto.app/welcome", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "expect": null },
    { "name": "split deployment: a second-level host is rejected", "url": "https://a.b.adto.app/welcome", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "expect": null },
    { "name": "split deployment: another root is rejected", "url": "https://demo.example.com/welcome", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "expect": null },
    { "name": "development query form", "url": "https://localhost:3000?user=demo/welcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "localhost without ?user", "url": "https://localhost:3000/demo/welcome", "baseUrl": "https://adto.app", "expect": null },
    { "name": "?user without a slug", "url": "https://localhost:3000?user=demo", "baseUrl": "https://adto.app", "expect": null },
    { "name": "?user with too many parts", "url": "https://localhost:3000?user=a/b/c", "baseUrl": "https://adto.app", "expect": null },
    { "name": "development scheme needs no tag", "url": "adto://demo/welcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "development scheme without a slug", "url": "adto://demo", "baseUrl": "https://adto.app", "expect": null },
    { "name": "a deep-link path is the app route; adto_l names the link", "url": "istoria://products/42?color=black&adto_click=abc123&adto_l=demo/welcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "the no-path scheme form carries the tag too", "url": "istoria://demo/welcome?adto_l=demo/welcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "an encoded slash in the tag", "url": "istoria://feed?adto_l=demo%2Fwelcome", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "an app route without the tag is not a link", "url": "istoria://products/42", "baseUrl": "https://adto.app", "expect": null },
    { "name": "an untagged username/slug shape on an app scheme is not a link", "url": "istoria://demo/welcome", "baseUrl": "https://adto.app", "expect": null },
    { "name": "a tag without a slug", "url": "istoria://x?adto_l=demo", "baseUrl": "https://adto.app", "expect": null },
    { "name": "a tag with a space in the slug", "url": "istoria://x?adto_l=demo/wel%20come", "baseUrl": "https://adto.app", "expect": null },
    { "name": "a tag without a username", "url": "istoria://x?adto_l=/welcome", "baseUrl": "https://adto.app", "expect": null },
    { "name": "a trailing path after the slug on a subdomain link", "url": "https://demo.adto.app/welcome/products/42", "baseUrl": "https://adto.app", "expect": { "username": "demo", "slug": "welcome" } },
    { "name": "a custom link domain", "url": "https://go.brand.app/sale?utm_source=x", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["go.brand.app"], "username": "demo", "expect": { "username": "demo", "slug": "sale" } },
    { "name": "a custom link domain before the account is known: the username is filled in later", "url": "https://go.brand.app/sale", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["Go.Brand.app."], "expect": { "username": "", "slug": "sale" } },
    { "name": "the path form on a custom link domain", "url": "https://go.brand.app/r/demo/sale", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["go.brand.app"], "username": "demo", "expect": { "username": "demo", "slug": "sale" } },
    { "name": "a custom link domain without a slug", "url": "https://go.brand.app/", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["go.brand.app"], "username": "demo", "expect": null },
    { "name": "a domain the app did not list", "url": "https://go.other.app/sale", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["go.brand.app"], "username": "demo", "expect": null },
    { "name": "the API host in the list is not a custom domain", "url": "https://app.adto.app/pricing", "baseUrl": "https://app.adto.app", "linkRootDomain": "adto.app", "linkDomains": ["app.adto.app", "demo.adto.app"], "username": "demo", "expect": null }
  ]
}
